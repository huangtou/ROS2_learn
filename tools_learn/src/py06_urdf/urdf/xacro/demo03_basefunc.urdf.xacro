<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="demo02_func">
    <!-- 宏定义 -->
    <xacro:macro name="get_sum" params="num1 num2">
        <sum value="${num1 + num2}"/>
    </xacro:macro>

    
    <!-- 宏使用 -->
    <xacro:get_sum num1="10" num2="20"/>

    <xacro:get_sum num1="70" num2="30"/>

</robot>